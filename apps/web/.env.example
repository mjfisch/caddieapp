# ── GAI Caddie environment ─────────────────────────────────────────────
# Copy to .env.local (gitignored), here in apps/web. NEVER commit real values.

# Postgres (D2 = Neon). From the Neon dashboard / Vercel-Neon integration.
# Local dev example: postgresql://postgres@127.0.0.1:5433/gai_caddie
# Neon prod example: postgresql://USER:PASSWORD@HOST.neon.tech/gai_caddie?sslmode=require
DATABASE_URL=

# Anthropic API key — SERVER-SIDE ONLY (invariant #3).
# Read exclusively inside services/api (server) modules. Never expose to the client.
# Note the absence of a NEXT_PUBLIC_ prefix: that is deliberate and load-bearing.
ANTHROPIC_API_KEY=
